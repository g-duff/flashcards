# Run the whole app locally in ONE container: nginx + the Rust backend,
# wired like the pi — backend on 127.0.0.1:<port>, nginx the only
# published port, routing through the app's REAL, unmodified nginx.conf
# fragment loaded into a local copy of the shared nginx shell.
#
# NOT a deploy artifact. Production is server/Containerfile (cross-compiled
# static musl/ARMv6, `podman build -o`, never run). This is the
# integration check you run before a deploy; see dev/README.md.
#
#   ./dev/up.sh
#
# Build context is the app directory (the parent of dev/).

# --- 1. client bundle -------------------------------------------------
FROM docker.io/library/node:22-bookworm AS client
WORKDIR /app
COPY client/package.json client/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY client/ ./
RUN npm run build

# --- 2. server binary -----------------------------------------------
# A native glibc release build for the image's own arch — runs directly
# in stage 3 (same Debian bookworm). Production cross-compiles a static
# musl/ARMv6 binary instead; musl there is to dodge an ARMv6-specific
# glibc dynamic-linker bug that does not exist off that hardware, so a
# native glibc build is representative here. rusqlite's "bundled" feature
# compiles the SQLite C amalgamation; the rust:1-bookworm image already
# carries gcc, so that builds natively with no extra setup — only the
# ARM cross-build in server/Containerfile needs a C cross-toolchain.
FROM docker.io/library/rust:1-bookworm AS server
WORKDIR /build
COPY server/ ./
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release && \
    cp "target/release/$(grep '^name' Cargo.toml | head -1 | sed -E 's/.*"(.*)".*/\1/')" /server-bin

# --- 3. runtime: Debian bookworm + nginx (the pi's distro & proxy) ---
FROM docker.io/library/nginx:stable-bookworm
ARG APP

COPY dev/sandy-bank.conf /etc/nginx/conf.d/default.conf
RUN mkdir -p /var/www/default "/var/www/sandy-bank/${APP}" /data && \
    printf '<h1>sandy-bank</h1>\n' > /var/www/default/index.html

# The REAL, unmodified routing fragment — the same file `deploy.sh -n`
# installs on the pi. Its `proxy_pass http://127.0.0.1:<port>/` works here
# because the backend runs in this same container.
COPY nginx.conf /etc/nginx/sandy-bank.d/app.conf

COPY --from=client /app/dist/ /var/www/sandy-bank/${APP}/
COPY --from=server /server-bin /usr/local/bin/app-server

COPY dev/entrypoint.sh /entrypoint.sh
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
